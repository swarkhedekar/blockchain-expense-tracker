{
  "name": "blockchain-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Blockchain-based expense tracker on Monad Testnet",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
